# AgriCare AI — Backend Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/agricare
JWT_SECRET=agricare-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://agri-care-sand.vercel.app

# Weather Configuration
# Leave blank to use the free Open-Meteo API automatically (no key required!)
# Or enter your OpenWeatherMap key and set WEATHER_PROVIDER=openweather
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# AI Provider Configuration (Google Gemini Vision & Text)
# Optional: If omitted, AgriCare runs in labeled, realistic demonstration mode
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-3.1-flash-lite

# Crop Detection Provider ('auto', 'gemini', or 'demo')
CROP_DETECTION_PROVIDER=auto
